;p1popt
;This is to record a nutation curve outside of the popt module. 
;Need to define a VPList (in µs!)
;
;$CLASS=tk506
;$DIM=pseudo 2D
;$TYPE=popt
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
define list<pulse> vp_list=<$VPLIST>

"acqt0=-p1*2/3.1416"



1 ze
p1 ph1
1u pl1:f1
2 30m
  d1
  (vp_list ph1):f1
  go=2 ph31
  10m wr #0 if #0 vp_list.inc
lo to 1 times td1
exit


ph1=0 2 2 0 1 3 3 1
ph31=0 2 2 0 1 3 3 1


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;ns: 1 * n, total number of scans: NS * TD0
;vp_list: pulse duration (us)



;$Id:$
