; homofslg.tk506 from lghetfq
; To reference the indirect dimension of hetcors

;See:
;Efficient Referencing of FSLG CPMAS HETCOR Spectra Using 2D 1H1H MAS FSLG
;Bharti Kumari, Martin Brodrecht, Torsten Gutmann, Hergen Breitzke & Gerd Buntkowsky 
;Applied Magnetic Resonance volume 50, pages 13991407 (2019)Cite this article 

; From HETCOR:
; 0) Reference the spectrometer (ideally changing field value)
; 1) Run Hetcor experiment (be careful of artefacts at the position of the carrier frequency)
; 2) new exp + pulprog -> homofslg.tk506
; 3) swap f1/f2 for proton detection. ns = 4. Reduce RG. Potentially Increase TD
; 4) Run experiment, xfb. There should be some diagonal signals, but the scaling+offset of the indirect dimension might be wrong. 
;   -> Scaling might be wrong because the LG-RF field (cnst20) is not perfectly known
; 5) Change indirect scaling:
; 5.1) s in_f -> s in_f*(distance peaks f2/distance peaks f1)
; 5.2) then .cal to set indirect dimension
; 6) in_f + 1H SR values are the ones to transfer to the hetcor (assuming it was run using identical O1, cnst20, etc.)
; Since in_f is overwritten when running a spectrum, this needs to come after running the hetcor


;
;Avance III version
;parameters:
;d1 : recycle delay
;pl1 : for X contact pulse
;sp0 : proton power level during contact
;pl2 : =120dB, not used
;pl12: for decoupling and excitation 1H
;pl13: for homonuclear decoupling
;p3 : 90 degree 1H pulse excitation
;p5 : FSLG 2pi pulse set by lgcalc.incl

;cnst20: LG-RF field as adjusted, in Hz used to calculate cnst22 and cnst23 +and - LG frequency
;cnst22: +LG frequency offset 
;cnst23: -LG frequency offset
;cnst24: offset for proton evolution under LG, usually 0 - -2000
;spnam0 : shape for contact pulse ramp.100
;l3 : for dwell in t1 = 4*p5*l3*0.578
;in0 : t1 increment
;ns : 2 or n*4
;FnMODE: undefined
;mc2	: STATES-TPPI
;nd0  : 1
;WDW  : QSINE 
;SSB  : 3 
;zgoptns : -Dlacq, -Dlcp15 or blank
;
;
;$CLASS=tk506
;$DIM=2D
;$TYPE=cross polarisation
;$SUBTYPE=heteronuclear correlation
;$COMMENT=HETCOR (CP based), FLSG during t1

prosol relations=<solids_cp>


define loopcounter count
"count=td1/2"


#include <lgcalc.incl>	
			;calculate p5 and frequency offsets cnst22 and 23
define pulse pul54
"pul54=(p3*547)/900"
define delay dwellf1
"in0=(0.578*l3*4*294/360)/cnst20"
"dwellf1=in0"
"inf1=in0"
"l0=0"
"blktr2=1u"
"blktr1=2u"
;cnst11 : to adjust t=0 for acquisition, if digmod = baseopt
"acqt0=1u*cnst11"

1 ze                             ; zero data
2 d1 do:f1                       ; recycle time, decoupler off


  1u fq=cnst21:f1                    ; set power level of f1
  dwellf1
  (p3 pl12 ph0):f1
  (pul54 ph1):f1               	 ; magic angle excitation pulse
3 (p5 ph3 fq=cnst22 pl13):f1	;fslg loop at pl13, LG frequ. 1
  (p5 ph4 fq=cnst23):f1		;fslg loop at pl13, LG frequ. 2
  (p5 ph3 fq=cnst22):f1 		;fslg loop at pl13, LG frequ. 1
  (p5 ph4 fq=cnst23):f1		;2 LG periods total
  lo to 3 times l0	
  (pul54 pl12 fq=cnst21 ph7):f1   ;minus magic angle pulse, flip back to xy plane
d2
  (p3 pl12 ph8):f1

  go=2  ph31 			;acquire
  1m                  
  10u do:f1                   	;switch off decoupler
  100m wr #0 if #0 zd
  1m ip0
  lo to 2 times 2
4 1m iu0
  lo to 4 times l3
  ;1m rp0 			; for STATES method
  lo to 2 times count
HaltAcqu, 1m		;jump address for protection files
exit                   	;exit
ph0=1 
ph1=1
ph2=0 0 2 2 1 1 3 3  
ph3=0
ph4=2
ph7=1 
ph8 = 0 2 2 0 1 3 3 1
ph10=0
ph31=0 2 2 0 1 3 3 1
    


;$Id:$
