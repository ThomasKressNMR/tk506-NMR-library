;CPMG + CPMG dection
;tk506 160224
;avance-version (17/03/20)
;for single scan T2
;
;$CLASS=tk506
;$DIM=2D
;$TYPE=
;$SUBTYPE=
;$COMMENT=


#include <Avance.incl>
#include <Delay.incl>
#include <De.incl>



define loopcounter lcount1
define loopcounter lcount2
define loopcounter td_val



define list<loopcounter> cpmgindirect=<$VCLIST>
"l20 = td/2"
"p2=p1*2"
"d12=20u"


"d20 = 0.5*(1s/(2*cnst10)-p2)"
"if ( de > 20u ) { DELTA = 20u; } else { DELTA = de; }"

"DELTA1=d20-p2/2-p1*2/PI-DELTA-de-0.25u"
"DELTA2=d20-p2/2-dw-DELTA-0.15u"
"DELTA3=d20-p2/2-dw-DELTA-0.1u"

"TAU1=dw-0.05u"
"TAU2=dw"


"lcount1=l20-1"
"lcount2=grpdly"
"td_val=(l20+grpdly)*2"

;fisrt cpmg

"d11 = 30m"

"d26 = d20"

define delay aqdirect
"aqdirect = d20*2*l20"
;aqdirect: Acquisition time in direct dimension

define delay indirecttime
"indirecttime = d20*2*cpmgindirect.max"
;indirecttime: Max time in indirect dimension

start, 1u
lo to start times td_val
aqdirect
indirecttime

1 ze
  d12 pl1:f1

rppall ; reset all phase pointers

2 30m
  20u ip30+cnst30
  d1

;first cpmg
p1:f1 ph11
cpmgLoop2, d26
    p2 ph12 ;ph4
    d26
    lo to cpmgLoop2 times cpmgindirect
    p1 ph13
;mix
    d8
;second cpmg

  (p1 ph1)
  ACQ_START(ph30,ph31)
  0.05u DWELL_HOLD
  0.1u START_NEXT_SCAN

  DELTA1
  0.1u REC_BLK
  DELTA
  (p2 ph2):f1
  DELTA
  0.1u REC_UNBLK
  DELTA3
  0.05u DWELL_RELEASE
  TAU1

  TAU2
  0.05u DWELL_HOLD

4 DELTA2
  0.1u REC_BLK
  DELTA
  (p2 ph2):f1
  DELTA
  0.1u REC_UNBLK
  DELTA3
  0.05u DWELL_RELEASE
  TAU1

  TAU2
  0.05u DWELL_HOLD
  lo to 4 times lcount1

5 DELTA2
  0.1u REC_BLK
  DELTA
  TAU
  DELTA
  0.1u REC_UNBLK
  DELTA3
 0.05u DWELL_RELEASE
  TAU1

  TAU2
  0.05u DWELL_HOLD
  lo to 5 times lcount2

  0.1u REC_BLK
  0.05u DWELL_RELEASE
  rcyc = 2

d11 wr #0 if #0 zd
1u cpmgindirect.inc
lo to 1 times td1
exit

;ph11= 0 0 0 0  0 0 0 0  2 2 2 2  2 2 2 2
;ph12= 1 3 1 3  1 3 1 3  1 3 1 3  1 3 1 3
;ph13= 2 2 2 2  0 0 0 0  0 0 0 0  2 2 2 2
;;       +z       -z       +z        -z
;ph1=  0 2 1 3  2 0 3 1 
;ph2=  1 3 2 0   
;ph30= 0 2 1 3
;ph31= 0 2 1 3   

ph11= 0 0  0 0  2 2   2 2 
ph12= 1 3  1 3  1 3   1 3 
ph13= 2 2  0 0  0 0   2 2 
;     +z   -z   +z    -z
ph1=  0 2 2 0  0 2 2 0
ph2=  1 3 3 1  3 1 1 3
ph30= 0 
ph31= 1 3  


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  90 degree high power pulse
;p2 : f1 channel - 180 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;d20: fixed echo time to allow elimination of J-mod. effects
;        d20 should be << 1/J ,but > (50 * p2)       [1-2 msec]
;cnst30: additional receiver phase setting to have intensity in real channel
;l20: number of echos
;ns: 4*n
;td: number of echos

;define vclist, multiple of 2
;cnst10: cpmg frequency
;d8: mixing time

;$Id:$
