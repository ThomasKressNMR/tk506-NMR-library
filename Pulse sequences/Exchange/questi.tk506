;questi: apply a saturation of increasing duration to study exchange
; i = interleaved: will saturate at +cnst1, then -cnst1 offsets (interleaved like in a REDOR)
; Note: set TD to twice the number of values found in VPLIST (because of interleaving)

;see e.g. https://www.sciencedirect.com/science/article/pii/S0079656520300212

;$CLASS=tk506
;$DIM=pseudo 2D
;$TYPE=Exchange
;$SUBTYPE=
;$COMMENT=14/10/23

#include <Avance.incl>


"d12=20u"


"acqt0=-p1*2/3.1416"
"d11 = 30m"

define list <pulse> vp_list=<$VPLIST>

"cnst53 = (1/(4*p1))*1000000"
"plw9=plw1*pow(10,(2*log10(cnst52/cnst53)))"



"cnst2 = -cnst1"
define loopcounter nfid
"nfid = td1/2"

1 ze
2 30m
  10u fq=cnst1:f1
  (vp_list pl9 ph29):f1 	;proton spin lock pulse at pl14
  4u do:f1
  10u fq=0:f1
  d12 pl1:f1 
  p1 ph1
  go=2 ph31
  d11 wr #0 if #0 zd  

12 d12 fq=cnst2:f1
  (vp_list pl9 ph29):f1 	;proton spin lock pulse at pl14
  4u do:f1
  10u fq=0:f1
  d12 pl1:f1 
  p1 ph1
  go=12 ph31
  d11 wr #0 if #0 zd

  1u vp_list.inc

  lo to 2 times nfid
HaltAcqu, 1m
exit


ph1=0 2  1 3 
ph29=0
ph31=0 2  1 3 


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;ns: 1 * n, total number of scans: NS * TD0
;cnst1: frequency offset (negative = right, positive = left)
;cnst53: hard pulse strength


;$Id:$
