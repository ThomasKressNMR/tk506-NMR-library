; for T1-T2 correlation plot
; simplified from diffREXSY
; $CLASS=tk506
; $DIM=3D
; $TYPE=
; $SUBTYPE=
; $COMMENT=

#include <Avance.incl>


#include <De.incl>

"p2=p1*2"
"d11=30m"
"d20 = 0.5*(1s/(2*cnst10)-p2)"
define delay cpmgtime
"cpmgtime = l1*(d20*2+p2)" 

define delay sattime
"sattime = l21*(d21+p1)" 


aqseq 321

"acqt0=0"

1 ze
cpmgtime
sattime
10u

start, 1u

#ifdef train
    d1
    2 d21
    (p1 pl1 ph4):f1
    lo to 2 times l21
#else
#ifdef saturation
        10u pl9:f1
        d1 cw:f1 ph29
        1u do:f1 pl1:f1
#else
        d1
#endif
#endif

d8
    p1 ph1
3 d20
    p2 ph2
    d20
    lo to 3 times l1
  go=start ph31
  wr #0
exit

ph1=0 0 2 2 1 1 3 3 
ph2=1 3 1 3 0 2 0 2
ph4=0
ph29=0
ph31=0 0 2 2 1 1 3 3

;pl1: f1 channel - power level for pulse (default)
;p1: f1 channel - 90-degree high power pulse
;p2: f1 channel - 180-degree high power pulse
;d1: relaxation delay; 1-5 * T1
;d11: delay for disk I/O [30 msec]

;cnst10: cpmg frequency
;vc: variable loop counter, taken from vc-list
;vd: variable recovery delay

;ns: 8 * n, min 4
;ds: 8
;td1: number of experiments = number of values in vd-list
;td2: number of experiments = number of values in vc-list

;define VCLIST and VDLIST
;l21: number of pulses in saturation pulse train, 0 if undesired

;d21: delay in saturation pulse train
;vc: vc should contain even numbers to provide
;for cancellation of 180-degree pulse errors

;d8 recovery time
;l1: even number of cpmg echoes

;set Dtrain or Dsaturation flag

; $Id:$
