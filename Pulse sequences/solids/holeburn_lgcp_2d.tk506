;holeburn_lgcp_2d.tk506 (TopSpin 2.0)
;Made with despair by T. Kress on the 25/06/2020
;1H{13C} Redor hole burning with homonuclear decoupling

;$COMMENT=tk506
;$CLASS=Interface-editing
;$DIM=pseudo 2D
;$TYPE=direct excitation
;$SUBTYPE=
;$OWNER=tk506

;parameters:
;ns : 32 * n
;d1 : recycle delay
;d31 : MAS period
"d31 = 1s/cnst31"

; ### For REDOR ###
define delay del25		;calculate sync. delays
"del25=(0.25s/cnst31)-(p4/2)"
define delay del26
"del26=(0.25s/cnst31)-(p12/2)"
define delay del27
"del27=(0.25s/cnst31)-(p3/2)"
;p12: 180deg pulse 13C
;deph; Dephasing delay "deph = d31*(1+l0)"
define delay decdelay
"decdelay = del27 + del25 + l0*(del26*2+p12)"
"l2 = decdelay/32u" ;appx number of dumbo cycles
"p32 = (decdelay/l2)*(1/64)"
define delay deph
"deph = 2*decdelay+p12"

;### Presat
;l20: number of presat pulses
;p20: 90deg pulse 13C
"p20 = p12/2"

; ### For T2 filter ###
;cnst31 : MAS spin rate / Hz
;l0 : 2n+1 / Number of REDOR pulses
;p3 : proton 90 at power level pl12
;p4 : proton 180 at pl12
"p4=p3*2"
;d20: presat delay

; ### Spin diffusion ###
;d8 : spin diffusion delay

; ### LG
;cnst20: 	LG-RF field as adjusted, in Hz used to calculate cnst22 and cnst23 +and - LG frequency
;cnst22: 	+LG frequency offset
;cnst23: 	-LG frequency offset
;cnst24: 	offset for proton evolution under LG, usually 0 - -2000
;p5 : 		FSLG 2pi pulse

"cnst21=0"													;make sure cp is done with proton freq. set by O2
"cnst22=cnst20/sqrt(2)+cnst24"			;cnst20=desired RF field in Hz
"cnst23=-cnst20/sqrt(2)+cnst24"			;negative offset is cnst23
define pulse pul54
"pul54=(p3*547)/900"

; ### For CP ###

;p15 : 			Contact time
;pl1 : 			X power level during contact
;pl2 : 			proton power level during contact
;pl12 : 		SPINAL64 Heteronuclear decoupling power level
;pl13 : 		DUMBO homonuclear decoupling power level
;d1 : 			recycle delay
;p31 : 			SPINAL64 pulse length
;cpdprg2 : 	SPINAL64
;cpdprg3 : 	edumbo_p32.tk506
;spnam0 : 	use e.g. ramp.100 for variable amplitude CP

prosol relations=<solids_cp>

#include <trigg.incl>
			;10 usec trigger pulse at TCU connector I cable 6
#include <tppm.incl>

1 ze
deph
decdelay

2 d1 do:f2		;recycle delay, decoupler off in go-loop
#include <p15_prot.incl>
			;make sure p15 does not exceed 10 msec
#include <aq_prot.incl>
			;allows max. 50 msec acquisition time, supervisor may change  to max. 1s at less than 5 % duty cycle and reduced decoupling field

#include <rot_prot.incl>
			;protect against misset cnst31, must be >1000

  1u fq=cnst21:f2
  10u pl11:f1 pl3:f2	;preselect power levels for f1 and f2

;###### 13C presat ######
3 (p20 ph20^):f1 	;13C preat
  d20
  lo to 3 times l20

;###### REDOR with homonuclear decoupling ######
  trigg						;trigger for scope, 10 usec
  (p3 ph1):f2 		; 90 1H
  1u cpds3:f2 		;DUMBO homonuclear decoupling on / set pl13
  del27
4 del26
  (p12 ph8^):f1		;Redor pulse 180 13C
  del26
  lo to 4 times l0
  del25
  1u do:f2				;DUMBO homonuclear decoupling off
  (p4  ph2):f2		;180 1H
  1u cpds3:f2 		;DUMBO homonuclear decoupling on / set pl13
  del25
5 del26
  (p12 ph9^):f1		;Redor pulse 180 13C
  del26
  lo to 5 times l0
  del27
  1u do:f2				;DUMBO homonuclear decoupling off

;###### z storage for spin diffusion ######
	(p3 ph3):f2
  vd
  10u pl1:f1

;######  Cross polarisation ######
  ;trigg
  p3:f2 ph11				;90 1H
  pul54:f2 ph11
  0.3u fq=cnst22:f2
  (p15 ph12):f1 (p15:spf0 pl2 ph10):f2 	;contact pulse with square or ramp
  1u cpds2:f2 			;SPINAl-64 heteronuclear proton decoupling/ pl12 + p31
  go=2 ph31  				;select appropriate decoupling sequence, cw or
  1m do:f2					;decoupler off
30m wr #0 if #0	ivd	;save data to disk
lo to 1 times td1
HaltAcqu, 1m				;jump address for protection files
exit								;quit

ph0 = 0
ph1 = 1 ;90h
ph2 = 0 ; 180h
ph3 = 1 1 3 3; 90h
; -z -z +z +z
ph11 = 1 3 3 1
ph12 = 0
ph10 = 0
ph21 = 1
ph31 = 0 2

ph8= 0 1 0 1 1 0 1 0
ph9= 0 1 0 1 1 0 1 0

;Random phases for presat
ph20= 201 4 190 125 305 86 79 65 3 77 75 40 70 85
