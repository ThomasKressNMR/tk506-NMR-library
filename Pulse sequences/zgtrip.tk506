;zgtrip.tk506

; Triple-pulse excitation suppresses probe background signals
; and RF acoustic ringing by phase-cycled destructive interference.
; from https://doi.org/10.1016/j.jmr.2021.107067 paper

; Topspin 4.5.0

;$CLASS=tk506
;$DIM=1D
;$TYPE=1D
;$SUBTYPE=
;$COMMENT=
;$OWNER=tk506

#include <Avance.incl>

"acqt0=-p1*2/3.1416"


1 ze
2 30m
  d1
  p1 ph1
  p1 ph2
  p1 ph3
  go=2 ph31
  30m mc #0 to 2 F0(zd)
exit


ph1=0 2 0 2 0 2 0 2 1 3 1 3 1 3 1 3
ph2=2 2 0 0 2 2 0 0 3 3 1 1 3 3 1 1
ph3=0 0 0 0 2 2 2 2 1 1 1 1 3 3 3 3
ph31=0 2 2 0 2 0 0 2 1 3 3 1 3 1 1 3


;pl1 : f1 channel - power level for pulse (default)
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;ns: 1 * n, total number of scans: NS * TD0


;$Id:$
