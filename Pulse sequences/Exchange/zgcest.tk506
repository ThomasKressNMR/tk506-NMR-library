;zgCEST 14/10/23
;To monitor exchange by saturating peaks
;see e.g. https://www.sciencedirect.com/science/article/pii/S0079656520300212
;saturate offset defined in FQ1LIST, then record zg 1d spectrum

;$CLASS=tk506
;$DIM=pseudo 2D
;$TYPE=Exchange
;$SUBTYPE=
;$COMMENT=

define list <frequency> FQ1=<$FQ1LIST>

#include <Avance.incl>

"d12=20u"

"acqt0=-p1*2/3.1416"
"d11 = 30m"

"cnst53 = (1/(4*p1))*1000000"
"plw9=plw1*pow(10,(2*log10(cnst52/cnst53)))"


1 zd
2 30m
  d12 pl9:f1 
  10u FQ1:f1
  d1 cw:f1 ph29 
  4u do:f1

  10u fq=0:f1
  d12 pl1:f1 
  p1 ph1
  go=2 ph31

  d11 wr #0 if #0 FQ1.inc
  lo to 1 times td1
HaltAcqu, 1m
exit


;ph1=0 2 2 0 1 3 3 1
;ph29=0
;ph31=0 2 2 0 1 3 3 1

ph1=0 2 1 3
ph29=0
ph31=0 2 1 3


;pl1 : f1 channel - power level for pulse (default)
;pl9 : f1 channel - power level for presaturation
;p1 : f1 channel -  90 degree high power pulse
;d1 : relaxation delay; 1-5 * T1
;d12: delay for power switching                      [20 usec]
;ns: 1 * n, total number of scans: NS * TD0
;Nutation frequency in Hz (pulse power)
;cnst52: irradiation strength in Hz
;cnst52: hard pulse strength in Hz

;$Id:$
