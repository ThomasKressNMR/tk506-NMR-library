;zgig
;Time-resolved 1d with heteronuclear decoupling, based on zgig
;Maximum time resolution allowed. DELTA gives time resolution.

;$CLASS=tk506
;$DIM=pseudo 2D
;$TYPE=In Situ
;$SUBTYPE=
;$COMMENT=

#include <Avance.incl>
#include <Delay.incl>
"d11=30m"

"acqt0=-p1*2/3.1416"

"DELTA=((d1+aq+60m)*(ns+ds))"

1 ze
  d11 pl12:f2
  DELTA
2 30m do:f2
  d1
  p1 ph1
  go=2 ph31 cpd2:f2
  30m do:f2 wr #0 if #0 ze
  lo to 2 times td1
exit

ph1=0 2 1 3 
ph31=0 2 1 3 

;pl1 : f1 channel - power level for pulse (default)
;pl12: f2 channel - power level for CPD/BB decoupling
;p1 : f1 channel -  high power pulse
;d1 : relaxation delay; 1-5 * T1
;d11: delay for disk I/O                             [30 msec]
;ns: 2 * n, total number of scans: NS * TD0
;cpd2: waltz65, decoupling according to sequence defined by cpdprg2
;pcpd2: f2 channel - decoupling degree pulse for decoupling sequence (waltz65:90º)

;$Id:$
